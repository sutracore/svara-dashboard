# PLACEHOLDERS ONLY. Copy to the application root as .env, then replace values.
# Do not put actual customer secrets in this template or in the source ZIP.

# PostgreSQL for the supplied Docker Compose setup.
POSTGRES_USER=svara_user
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=svara
POSTGRES_PORT=5432
# Use the same password above, URL-encoded, in this connection string.
DATABASE_URL=postgresql://svara_user:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@localhost:5432/svara

# Keep these origins aligned. Replace all with the deployed HTTPS origin at launch.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Read only by the legacy /auth/join page.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_LOCALLY_GENERATED_RANDOM_AUTH_SECRET

# Disable demo form prefills. The hardcoded demo card also needs removal in code.
NEXT_PUBLIC_TEST_EMAIL=
NEXT_PUBLIC_TEST_PASSWORD=

# Cloudflare R2: required for profile/workspace image uploads.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PREFIX=SvaraAI

# Resend: required for verification/recovery OTPs and workspace invitations.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Svara AI <no-reply@mail.customer.example>"

# Stripe: the first three are required together to enable the Stripe plugin.
# Leave blank until real TEST values are available; never mix test and live objects.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY_ID=
# Optional; customer Enterprise checkout is not exposed by the current plan UI.
STRIPE_PRICE_ENTERPRISE_MONTHLY_ID=
